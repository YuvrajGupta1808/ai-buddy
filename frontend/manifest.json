{
  "manifest_version": 3,
  "name": "AI Buddy",
  "version": "1.0.0",
  "description": "Your AI Assistant for summarizing, translating, web searching, and chatting",
  "action": {
    "default_title": "Open side panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}